# Inbound MCP authentication. Use different strong values per service in production.
GMI_MCP_SERVER_AUTH=replace-with-a-long-random-token
LEXWARE_MCP_SERVER_AUTH=replace-with-a-different-long-random-token
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# GetMyInvoices provider configuration. Endpoint paths and parameter names must be
# copied from the API documentation applicable to the connected account.
GMI_API_BASE_URL=https://api.getmyinvoices.com
GMI_API_TOKEN=replace-server-side-only
GMI_AUTH_HEADER=Authorization
GMI_AUTH_SCHEME=Bearer
GMI_ACCOUNT_SCOPE=replace-account-id
GMI_ACCOUNT_SCOPE_PARAM=account_id
GMI_LIST_PATH=/replace/from/current/provider/docs
GMI_DETAIL_PATH_TEMPLATE=/replace/from/current/provider/docs/{document_id}
GMI_DOWNLOAD_PATH_TEMPLATE=/replace/from/current/provider/docs/{document_id}/download
GMI_TYPES_PATH=
GMI_LIST_PARAM_MAP_JSON={"date_from":"date_from","date_to":"date_to","document_type":"document_type","status":"status","supplier":"supplier","page_size":"page_size","cursor":"cursor"}

# Lexware Office provider configuration.
LEXWARE_API_BASE_URL=https://api.lexware.io
LEXWARE_API_TOKEN=replace-server-side-only
LEXWARE_ORGANIZATION_SCOPE=00000000-0000-0000-0000-000000000000

# Shared hardening and download settings.
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_SIZE=250
MAX_DOWNLOAD_BYTES=20971520
MAX_DATE_RANGE_DAYS=366
DOWNLOAD_TTL_SECONDS=900
LOG_LEVEL=INFO

