# This file is read by docker compose for variable interpolation only. Each
# container receives just the variables listed for it in docker-compose.yml.

# Inbound MCP authentication. Use different strong values per service in production.
GMI_MCP_SERVER_AUTH=replace-with-a-long-random-token
LEXWARE_MCP_SERVER_AUTH=replace-with-a-different-long-random-token
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional public HTTPS base URL per service (download links, OAuth issuer).
GMI_PUBLIC_BASE_URL=
LEXWARE_PUBLIC_BASE_URL=

# GetMyInvoices Accounts API v3. Use an API key of type READ_ONLY ("API Access"
# in the GetMyInvoices account menu); the service refuses any other key type.
GMI_API_BASE_URL=https://api.getmyinvoices.com/accounts/v3
GMI_API_TOKEN=replace-server-side-only
GMI_AUTH_HEADER=X-API-KEY
GMI_AUTH_SCHEME=
# Your GetMyInvoices account id as returned by GET /account (e.g. G-12345-0).
GMI_ACCOUNT_SCOPE=replace-account-id
# GetMyInvoices binds the account to the key; no scope query parameter is sent.
GMI_ACCOUNT_SCOPE_PARAM=
GMI_REQUIRE_READ_ONLY_KEY=true
GMI_USER_AGENT_PRODUCT=abschlusspruefer-de-mcp/1.0
GMI_ACCOUNT_PATH=/account
GMI_LIST_PATH=/documents
GMI_DETAIL_PATH_TEMPLATE=/documents/{document_id}
GMI_DOWNLOAD_PATH_TEMPLATE=/documents/{document_id}
# UNCONFIRMED: name of the query parameter that switches file content on/off for
# GET /documents/{documentUid}. Fill in from the official docs, e.g. {"<param>":"false"}.
GMI_DETAIL_QUERY_JSON=
GMI_DOWNLOAD_QUERY_JSON=
# UNCONFIRMED: JSON field carrying the (assumed base64) file.
GMI_FILE_CONTENT_FIELD=fileContent
# Optional comma separated override of the documentTypeFilter enum.
GMI_DOCUMENT_TYPES=
# Optional overrides of the default mapping (startDateFilter, endDateFilter,
# perPage, pageNumber, documentTypeFilter[], paymentStatusFilter, companyFilter).
GMI_LIST_PARAM_MAP_JSON=

# Lexware Office provider configuration.
LEXWARE_API_BASE_URL=https://api.lexware.io
LEXWARE_API_TOKEN=replace-server-side-only
LEXWARE_ORGANIZATION_SCOPE=00000000-0000-0000-0000-000000000000

# Shared hardening and download settings.
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_SIZE=250
MAX_DOWNLOAD_BYTES=20971520
MAX_DATE_RANGE_DAYS=366
DOWNLOAD_TTL_SECONDS=900
LOG_LEVEL=INFO

